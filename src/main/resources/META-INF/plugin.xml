<idea-plugin dynamic="true">
    <id>com.paulbaker.localize-plugin</id>
    <name>Localize Tool</name>
    <vendor>Paul Baker</vendor>
    <description>Generate localized strings.xml and JSON assets from CSV translation files.</description>

    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="com.paulbaker.localize.action.LocalizeAction"
                class="com.paulbaker.localize.action.LocalizeAction"
                text="Localize..."
                description="Generate localized strings.xml and JSON assets from CSV">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Localize"
                    anchor="right"
                    secondary="true"
                    canCloseContents="false"
                    icon="/icons/localize.svg"
                    factoryClass="com.paulbaker.localize.ui.LocalizeToolWindowFactory"/>
    </extensions>
</idea-plugin>
